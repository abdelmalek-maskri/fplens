// Cloudflare Workers static assets. There is no server-side Worker here: this
// only tells Cloudflare which directory holds the built site.

// not_found_handling makes any unmatched path return index.html, which is what
// a single page app needs: React Router reads the address and draws the right
// page. A _redirects catch-all would be more precise, but Cloudflare rejects
// "/* -> /index.html" as an infinite loop, so this is the supported route.
//
// Real files still win: /data/*.json exists on disk and is served normally.
// Only a genuinely missing file falls through to index.html, which turns a 404
// into a JSON parse error when debugging. Acceptable, since those files are
// committed and always present.
{
  "name": "fplens",
  "compatibility_date": "2026-09-15",
  // html_handling decides how a bare /accuracy finds dist/accuracy/index.html,
  // which the build now writes so each route has its own title and link
  // preview. The default, auto-trailing-slash, answers /accuracy with a 307 to
  // /accuracy/ and serves the file from there; drop-trailing-slash serves it
  // directly with a 200. React Router links carry no trailing slash and the
  // canonical URLs in those files do not either, so this is the mode that
  // matches them and skips a redirect on every deep link.
  //
  // "none" would break it outright: a bare /accuracy would match no asset and
  // fall through to the single-page-application handler, which is the generic
  // index.html this change exists to stop serving.
  "assets": {
    "directory": "./dist",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "single-page-application"
  }
}
