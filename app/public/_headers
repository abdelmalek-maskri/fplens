# Cloudflare reads this at deploy time and attaches these headers to matching
# paths. Without it everything is served max-age=0, must-revalidate, so a
# repeat visit revalidates every file over the network before using a copy it
# already has.

# Applies to every response. Rules below add Cache-Control to some paths; they
# set no header named here, so both apply.
#
# The news page renders Guardian headlines, which React escapes, so a headline
# containing a script tag is drawn as text. The policy below is the second
# lock, for the case where the first one is the thing that fails.
#
# connect-src names the deployed API explicitly because this file is static and
# cannot read VITE_API_URL. Change one and change the other, or My Team and
# News stop loading.
#
# 'unsafe-inline' is in style-src and not script-src. Nine components set
# style={{...}}, which the browser treats as an inline style, and there is no
# build step here that would hash them. Scripts have no such exception, which
# is the half of the policy that stops injected code running.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://fplens.onrender.com https://cloudflareinsights.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()

# Vite puts a content hash in these filenames, so the contents can never change
# without the name changing too. Safe to keep forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The snapshot job rewrites these once a day. Nothing reads them from a store,
# so every page mount refetches: three pages pull predictions_*.json and the
# player page pulls players.json.
#
# max-age covers a browsing session. After that stale-while-revalidate serves
# the cached copy immediately and refreshes it in the background, so the user
# never waits and is at most one page view behind.
/data/*
  Cache-Control: public, max-age=600, stale-while-revalidate=3600

/accuracy.json
  Cache-Control: public, max-age=600, stale-while-revalidate=3600

# index.html deliberately has no rule here. It keeps Cloudflare's
# must-revalidate default, and that is what makes the immutable rule above
# safe: the HTML is the only file whose name never changes, so it has to be
# rechecked to discover the new hashed asset names after a deploy.
